---
import Icon from "./Icon.astro";
import { contactChannels } from "../config/site";
---

<section
  id="contact"
  class="contact-section section-space"
  aria-labelledby="contact-title"
>
  <div class="container contact-grid">
    <div class="contact-copy">
      <span class="contact-symbol">
        <Icon name="message" />
      </span>
      <p class="eyebrow">NEED HELP?</p>
      <h2 id="contact-title" class="type-section">
        어떤 도움이
        <br />
        필요하신가요?
      </h2>
      <p class="contact-description">
        서비스에 대해 궁금한 점,
        <br />
        편하게 문의해 주세요.
      </p>
      <div class="contact-signature">
        <span class="small-line"></span>
        <span class="eyebrow">SKY CARE ZONE</span>
      </div>
    </div>
    <div class="contact-panel">
      <p class="eyebrow">CONTACT</p>
      <a class="contact-phone" href={`tel:${contactChannels.phone.number}`}>
        <span class="contact-phone-heading type-menu">
          <Icon name="phone" />
          전화 상담
        </span>
        <Icon name="diagonal" />
        <strong class="contact-phone-number">
          {contactChannels.phone.display}
        </strong>
      </a>
      <p class="contact-platform-label type-small">
        플랫폼에서도 문의하실 수 있어요.
      </p>
      <ul class="contact-platforms" role="list" aria-label="플랫폼 문의 채널">
        {contactChannels.platforms.map((platform) => (
          <li>
            <a
              class="contact-platform-link"
              href={platform.href}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={`${platform.name}로 문의하기 (새 창)`}
            >
              <img
                class="contact-platform-logo"
                src={platform.logo}
                width="200"
                height="200"
                alt=""
                loading="lazy"
                decoding="async"
              />
              <span class="contact-platform-name">
                {platform.name}
                <Icon name="diagonal" />
              </span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>
