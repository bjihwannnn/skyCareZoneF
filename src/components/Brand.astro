---
interface Props {
  compact?: boolean;
}
const { compact = false } = Astro.props;
---

<a
  class:list={["brand", { "brand--compact": compact }]}
  href="/"
  aria-label="SKY CARE ZONE 홈"
>
  <svg
    class="brand__symbol"
    width="42"
    height="42"
    viewBox="0 0 44 44"
    fill="none"
    aria-hidden="true"
  >
    <path
      d="M21 21C7 22 3 12 9 7c5-4 13 0 12 14Z"
      fill="var(--color-primary)"
    />
    <path
      d="M23 21C22 7 32 3 37 9c4 5 0 13-14 12Z"
      fill="var(--color-accent)"
    />
    <path
      d="M23 23c14-1 18 9 12 14-5 4-13 0-12-14Z"
      fill="var(--color-primary)"
    />
    <path
      d="M21 23c1 14-9 18-14 12-4-5 0-13 14-12Z"
      fill="var(--color-secondary)"
    />
  </svg>
  <span class="brand__wordmark">
    SKY CARE ZONE
    <span class="brand__tagline">공간을 위한 케어, 일상을 위한 여유</span>
  </span>
</a>
