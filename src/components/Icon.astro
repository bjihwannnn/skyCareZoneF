---
interface Props {
  name: string;
  class?: string;
}
const { name, class: className } = Astro.props;
---

<svg
  class={className}
  width="24"
  height="24"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.5"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
>
  {name === "arrow" && <path d="M4 12h15M13 6l6 6-6 6" />}
  {name === "diagonal" && <path d="M6 18 18 6M6 6h12v12" />}
  {name === "down" && <path d="M12 4v16m-6-6 6 6 6-6" />}
  {name === "air" && (
    <>
      <rect x="3" y="4" width="18" height="9" rx="2" />
      <path d="M6 10h12M7 16v4m5-4v2m5-2v4M17 7h1" />
    </>
  )}
  {name === "sofa" && (
    <>
      <path d="M5 12V8a3 3 0 0 1 3-3h8a3 3 0 0 1 3 3v4M5 18v2m14-2v2M7 13h10" />
      <path d="M5 11a2 2 0 0 0-2 2v5h18v-5a2 2 0 0 0-4 0v2H7v-2a2 2 0 0 0-2-2Z" />
    </>
  )}
  {name === "shield" && (
    <>
      <path d="m12 3 8 3v6c0 5-8 9-8 9s-8-4-8-9V6l8-3Z" />
      <path d="m8.5 12 2.5 2.5 4.5-5" />
    </>
  )}
  {name === "sparkle" && (
    <path d="m12 3 2.3 6.7L21 12l-6.7 2.3L12 21l-2.3-6.7L3 12l6.7-2.3L12 3Z" />
  )}
  {name === "message" && (
    <>
      <path d="M20 11.5a8 8 0 0 1-8 7.5H8l-5 3 1.5-5A7 7 0 0 1 3 12a8 8 0 0 1 8-8h1a8 8 0 0 1 8 7.5Z" />
      <path d="M8 10h8m-8 4h5" />
    </>
  )}
  {name === "image" && (
    <>
      <rect x="3" y="3" width="18" height="18" rx="3" />
      <circle cx="8" cy="8" r="1.5" />
      <path d="m3 17 5-5 4 4 4-6 5 7" />
    </>
  )}
  {name === "info" && (
    <>
      <circle cx="12" cy="12" r="9" />
      <path d="M12 11v5m0-9v.1" />
    </>
  )}
  {name === "document" && (
    <>
      <path d="M14 3H6a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V9l-6-6Z" />
      <path d="M14 3v6h6M8 13h8m-8 4h6" />
    </>
  )}
  {name === "help" && (
    <>
      <circle cx="12" cy="12" r="9" />
      <path d="M9.5 9a2.5 2.5 0 0 1 5 0c0 2-2.5 2-2.5 4m0 3v.1" />
    </>
  )}
</svg>
