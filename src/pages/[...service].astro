---
import type { GetStaticPaths } from "astro";
import SiteLayout from "../layouts/SiteLayout.astro";
import Contact from "../components/Contact.astro";
import Icon from "../components/Icon.astro";
import { services, type Service } from "../config/site";
import { serviceDetails, type ServiceDetails } from "../data/service-details";
export const getStaticPaths = (() =>
  services.map((service) => ({
    params: { service: service.path.slice(1) },
    props: { service, details: serviceDetails[service.id] },
  }))) satisfies GetStaticPaths;
interface Props {
  service: Service;
  details: ServiceDetails;
}
const { service, details } = Astro.props;
const { processSteps, usageGuideItems, casePhotos } = details;
const isThreeColumnGallery = service.id === "disinfection";
---

<SiteLayout
  title={`${service.title} | SKY CARE ZONE`}
  description={details.metaDescription}
>
  <div class="detail-intro">
    <div class="container">
      <nav class="breadcrumbs type-small" aria-label="현재 위치">
        <a href="/">홈</a>
        <span aria-hidden="true">/</span>
        <span aria-current="page">{service.title}</span>
      </nav>
      <div class="detail-title-row">
        <div>
          <p class="eyebrow">{service.english}</p>
          <h1 class="type-hero">{service.title}</h1>
          <p class="detail-description">{service.description}.</p>
        </div>
        <span class="detail-service-icon">
          <Icon name={service.icon} />
        </span>
      </div>
      <nav class="detail-navigation" aria-label="서비스 상세 목차">
        <a href="#process">작업 절차</a>
        <a href="#cases">작업 사례</a>
        <a href="#notes">이용 안내</a>
        <a href="#contact">
          케어 문의 <Icon name="diagonal" />
        </a>
      </nav>
    </div>
  </div>
  <section
    id="process"
    class="detail-section section-space"
    aria-labelledby="process-title"
  >
    <div class="container">
      <div class="section-heading">
        <div>
          <p class="eyebrow">01 / CARE PROCESS</p>
          <h2 id="process-title" class="type-section">
            작업 절차
          </h2>
        </div>
      </div>
      <ol class="process-steps" role="list" aria-label="4단계 작업 절차">
        {processSteps.map((step, index) => (
          <li class="process-step">
            <span class="process-number type-card" aria-hidden="true">
              {String(index + 1).padStart(2, "0")}
            </span>
            <div class="process-step-copy">
              <h3 class="type-card">{step.title}</h3>
              <p>{step.description}</p>
            </div>
            {index < processSteps.length - 1 && (
              <span class="process-connector" aria-hidden="true">
                <Icon name="arrow" />
              </span>
            )}
          </li>
        ))}
      </ol>
    </div>
  </section>
  <section
    id="cases"
    class="detail-section detail-cases section-space"
    aria-labelledby="cases-title"
  >
    <div
      class:list={[
        "container case-gallery-container",
        {
          "case-gallery-container--three-column": isThreeColumnGallery,
        },
      ]}
    >
      <div class="section-heading">
        <div>
          <p class="eyebrow">02 / CARE GALLERY</p>
          <h2 id="cases-title" class="type-section">
            작업 사례
          </h2>
        </div>
        <p class="section-description">사진으로 살펴보는 작업 현장.</p>
      </div>
      <div>
        <div class="case-gallery">
          {casePhotos.map((photo, index) => (
            <figure
              class:list={[
                "case-photo",
                {
                  "case-photo--featured": index === 0 && !isThreeColumnGallery,
                },
              ]}
            >
              <a
                class="case-photo-link"
                href={photo.src}
                target="_blank"
                rel="noopener"
                aria-label={`${photo.caption} — 원본 사진 보기 (새 창)`}
              >
                <img
                  src={photo.src}
                  width={photo.width}
                  height={photo.height}
                  alt={photo.alt}
                  loading="lazy"
                  decoding="async"
                />
              </a>
              <figcaption class="type-small">{photo.caption}</figcaption>
            </figure>
          ))}
        </div>
        <p class="case-gallery-hint type-small">
          사진을 선택하면 원본을 새 창에서 볼 수 있습니다.
        </p>
      </div>
    </div>
  </section>
  <section
    id="notes"
    class="detail-section section-space"
    aria-labelledby="notes-title"
  >
    <div class="container detail-section-grid usage-guide-layout">
      <div>
        <p class="eyebrow">03 / SERVICE GUIDE</p>
        <h2 id="notes-title" class="type-section">
          이용 안내
        </h2>
      </div>
      <ul class="usage-guide-list" role="list">
        {usageGuideItems.map((item) => (
          <li class="usage-guide-item">
            <span class="usage-guide-icon">
              <Icon name={item.icon} />
            </span>
            <p class="usage-guide-copy">{item.description}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>
  <Contact />
</SiteLayout>
