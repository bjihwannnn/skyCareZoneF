---
import type { GetStaticPaths } from "astro";
import SiteLayout from "../layouts/SiteLayout.astro";
import Contact from "../components/Contact.astro";
import Icon from "../components/Icon.astro";
import { services, type Service } from "../config/site";
import { serviceDetails, type ServiceDetails } from "../data/service-details";
export const getStaticPaths = (() =>
  services.map((service) => ({
    params: { service: service.path.slice(1) },
    props: { service, details: serviceDetails[service.id] },
  }))) satisfies GetStaticPaths;
interface Props {
  service: Service;
  details: ServiceDetails;
}
const { service, details } = Astro.props;
const { processSteps, usageGuideItems, isPlaceholder, casePhotos } = details;
---

<SiteLayout
  title={`${service.title} | SKY CARE ZONE`}
  description={details.metaDescription}
>
  <div class="detail-intro">
    <div class="container">
      <nav class="breadcrumbs type-small" aria-label="현재 위치">
        <a href="/">홈</a>
        <span aria-hidden="true">/</span>
        <span aria-current="page">{service.title}</span>
      </nav>
      <div class="detail-title-row">
        <div>
          <p class="eyebrow">{service.english}</p>
          <h1 class="type-hero">{service.title}</h1>
          <p class="detail-description">
            가정과 기업·사무실을 위한 {service.description}.
          </p>
        </div>
        <span class="detail-service-icon">
          <Icon name={service.icon} />
        </span>
      </div>
      <nav class="detail-navigation" aria-label="서비스 상세 목차">
        <a href="#process">작업 절차</a>
        <a href="#cases">작업 사례</a>
        <a href="#notes">이용 안내</a>
        <a href="#contact">
          케어 문의 <Icon name="diagonal" />
        </a>
      </nav>
    </div>
  </div>
  <section
    id="process"
    class="detail-section section-space"
    aria-labelledby="process-title"
  >
    <div class="container">
      <div class="section-heading process-heading">
        <div>
          <p class="eyebrow">01 / CARE PROCESS</p>
          <h2 id="process-title" class="type-section">
            작업 절차
          </h2>
        </div>
        {isPlaceholder && (
          <p
            class="type-small detail-layout-note"
            id="process-placeholder-note"
          >
            레이아웃 확인을 위한 임시 콘텐츠입니다.
          </p>
        )}
      </div>
      <ol
        class="process-steps"
        role="list"
        aria-label="4단계 작업 절차"
        aria-describedby={
          isPlaceholder ? "process-placeholder-note" : undefined
        }
      >
        {processSteps.map((step, index) => (
          <li class="process-step">
            <span class="process-number type-card" aria-hidden="true">
              {String(index + 1).padStart(2, "0")}
            </span>
            <div class="process-step-copy">
              <h3 class="type-card">{step.title}</h3>
              <p>{step.description}</p>
            </div>
            {index < processSteps.length - 1 && (
              <span class="process-connector" aria-hidden="true">
                <Icon name="arrow" />
              </span>
            )}
          </li>
        ))}
      </ol>
    </div>
  </section>
  <section
    id="cases"
    class="detail-section detail-cases section-space"
    aria-labelledby="cases-title"
  >
    <div class="container">
      <div class="section-heading">
        <div>
          <p class="eyebrow">02 / CARE GALLERY</p>
          <h2 id="cases-title" class="type-section">
            작업 사례
          </h2>
        </div>
        <p class="section-description">
          {casePhotos.length > 0
            ? "사진으로 살펴보는 작업 현장."
            : "실제 작업 사진은 준비 중입니다."}
        </p>
      </div>
      {casePhotos.length > 0 ? (
        <div>
          <div class="case-gallery">
            {casePhotos.map((photo, index) => (
              <figure
                class:list={[
                  "case-photo",
                  { "case-photo--featured": index === 0 },
                ]}
              >
                <a
                  class="case-photo-link"
                  href={photo.src}
                  target="_blank"
                  rel="noopener"
                  aria-label={`${photo.caption} — 원본 사진 보기 (새 창)`}
                >
                  <img
                    src={photo.src}
                    width={photo.width}
                    height={photo.height}
                    alt={photo.alt}
                    loading="lazy"
                    decoding="async"
                  />
                </a>
                <figcaption class="type-small">{photo.caption}</figcaption>
              </figure>
            ))}
          </div>
          <p class="case-gallery-hint type-small">
            사진을 선택하면 원본을 새 창에서 볼 수 있습니다.
          </p>
        </div>
      ) : (
        <div class="case-grid">
          <figure class="case-illustration">
            <img
              src={service.image}
              width="800"
              height="640"
              alt={service.imageAlt}
              loading="lazy"
            />
            <figcaption class="type-small">
              공간 연출 이미지 · 플레이스홀더 · 실제 작업 사례 아님
            </figcaption>
          </figure>
          <div class="case-placeholder">
            <Icon name="image" />
            <h3 class="type-card">작업 사진을 기다리고 있어요.</h3>
            <p class="type-small">
              확인된 {service.title} 사례가 등록될 공간입니다.
            </p>
          </div>
        </div>
      )}
    </div>
  </section>
  <section
    id="notes"
    class="detail-section section-space"
    aria-labelledby="notes-title"
  >
    <div class="container detail-section-grid usage-guide-layout">
      <div>
        <p class="eyebrow">03 / SERVICE GUIDE</p>
        <h2 id="notes-title" class="type-section">
          이용 안내
        </h2>
        {isPlaceholder && (
          <p class="type-small detail-layout-note" id="guide-placeholder-note">
            레이아웃 확인을 위한
            <br />
            임시 안내 문구입니다.
          </p>
        )}
      </div>
      <ul
        class="usage-guide-list"
        role="list"
        aria-describedby={isPlaceholder ? "guide-placeholder-note" : undefined}
      >
        {usageGuideItems.map((item) => (
          <li class="usage-guide-item">
            <span class="usage-guide-icon">
              <Icon name={item.icon} />
            </span>
            <p class="usage-guide-copy">{item.description}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>
  <Contact selectedService={service.title} />
</SiteLayout>
