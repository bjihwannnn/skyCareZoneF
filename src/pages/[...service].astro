---
import type { GetStaticPaths } from "astro";
import SiteLayout from "../layouts/SiteLayout.astro";
import Contact from "../components/Contact.astro";
import Icon from "../components/Icon.astro";
import { services, type Service } from "../config/site";
export const getStaticPaths = (() =>
  services.map((service) => ({
    params: { service: service.path.slice(1) },
    props: { service },
  }))) satisfies GetStaticPaths;
interface Props {
  service: Service;
}
const { service } = Astro.props;
---

<SiteLayout
  title={`${service.title} | SKY CARE ZONE`}
  description={`가정과 기업·사무실을 위한 SKY CARE ZONE의 ${service.title}. 상세 안내를 준비하고 있습니다.`}
>
  <div class="detail-intro">
    <div class="container">
      <nav class="breadcrumbs type-small" aria-label="현재 위치">
        <a href="/">홈</a>
        <span aria-hidden="true">/</span>
        <span aria-current="page">{service.title}</span>
      </nav>
      <div class="detail-title-row">
        <div>
          <p class="eyebrow">{service.english}</p>
          <h1 class="type-hero">{service.title}</h1>
          <p class="detail-description">
            가정과 기업·사무실을 위한 {service.description}.
          </p>
        </div>
        <span class="detail-service-icon">
          <Icon name={service.icon} />
        </span>
      </div>
      <nav class="detail-navigation" aria-label="서비스 상세 목차">
        <a href="#process">작업 절차</a>
        <a href="#cases">작업 사례</a>
        <a href="#notes">유의사항</a>
        <a href="#contact">
          케어 문의 <Icon name="diagonal" />
        </a>
      </nav>
    </div>
  </div>
  <section
    id="process"
    class="detail-section section-space"
    aria-labelledby="process-title"
  >
    <div class="container detail-section-grid">
      <div>
        <p class="eyebrow">01 / CARE PROCESS</p>
        <h2 id="process-title" class="type-section">
          작업 절차
        </h2>
      </div>
      <div class="content-pending">
        <span class="pending-icon">
          <Icon name={service.icon} />
        </span>
        <h3 class="type-card">케어 과정을 준비하고 있습니다.</h3>
        <p>
          확인된 작업 절차가 등록되면
          <br class="desktop-break" /> 이곳에서 자세히 안내해 드릴 예정입니다.
        </p>
        <span class="pending-badge type-small">상세 정보 준비 중</span>
      </div>
    </div>
  </section>
  <section
    id="cases"
    class="detail-section detail-cases section-space"
    aria-labelledby="cases-title"
  >
    <div class="container">
      <div class="section-heading">
        <div>
          <p class="eyebrow">02 / CARE GALLERY</p>
          <h2 id="cases-title" class="type-section">
            작업 사례
          </h2>
        </div>
        <p class="section-description">실제 작업 사진은 준비 중입니다.</p>
      </div>
      <div class="case-grid">
        <figure class="case-illustration">
          <img
            src={service.image}
            width="800"
            height="640"
            alt={service.imageAlt}
            loading="lazy"
          />
          <figcaption class="type-small">
            공간 연출 이미지 · 플레이스홀더 · 실제 작업 사례 아님
          </figcaption>
        </figure>
        <div class="case-placeholder">
          <Icon name="image" />
          <h3 class="type-card">작업 사진을 기다리고 있어요.</h3>
          <p class="type-small">
            확인된 {service.title} 사례가 등록될 공간입니다.
          </p>
        </div>
      </div>
    </div>
  </section>
  <section
    id="notes"
    class="detail-section section-space"
    aria-labelledby="notes-title"
  >
    <div class="container detail-section-grid">
      <div>
        <p class="eyebrow">03 / PLEASE NOTE</p>
        <h2 id="notes-title" class="type-section">
          유의사항
        </h2>
      </div>
      <div class="notice-panel">
        <Icon name="info" />
        <div>
          <h3 class="type-card">이용 전 안내를 준비하고 있습니다.</h3>
          <p>
            서비스 범위와 작업 관련 유의사항은
            <br class="desktop-break" /> 확정된 내용이 등록되면 안내해 드립니다.
          </p>
          <p class="type-small notice-caption">
            현재 상세 서비스 정보는 미확정 상태입니다.
          </p>
        </div>
      </div>
    </div>
  </section>
  <Contact selectedService={service.title} />
</SiteLayout>
