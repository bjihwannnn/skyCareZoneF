---
import SiteLayout from "../layouts/SiteLayout.astro";
import Contact from "../components/Contact.astro";
import Icon from "../components/Icon.astro";
import { services } from "../config/site";
---

<SiteLayout>
  <section class="hero" aria-labelledby="hero-title">
    <div class="container hero-grid">
      <div class="hero-copy">
        <p class="eyebrow hero-eyebrow">
          <span class="label-line"></span>SKY CARE ZONE
        </p>
        <h1 id="hero-title" class="type-hero">
          깨끗한 공간,
          <br />
          기분 좋은 <span class="hero-highlight">일상.</span>
        </h1>
        <p class="hero-description">
          에어컨 케어와 가구·패브릭 케어, 방역 케어까지.
          <br />
          SKY CARE ZONE의 전문 케어를 만나보세요.
        </p>
        <a class="hero-explore type-menu" href="#services">
          서비스 살펴보기{" "}
          <span class="circle-arrow">
            <Icon name="down" />
          </span>
        </a>
      </div>
      <figure class="hero-visual">
        <img
          src="/images/living-room.png"
          width="1448"
          height="1086"
          alt="벽걸이 에어컨과 밝은색 소파, 테이블 위 분무 용기와 수건이 있는 거실"
          fetchpriority="high"
        />
      </figure>
    </div>
  </section>
  <section class="hero-cta" aria-label="케어 문의 안내">
    <div class="container hero-cta-inner">
      <div class="cta-intro">
        <span class="cta-icon">
          <Icon name="sparkle" />
        </span>
        <div>
          <p>우리에게 필요한 케어,</p>
          <p class="type-small">SKY CARE ZONE과 함께 알아보세요.</p>
        </div>
      </div>
      <a class="button" href="#contact">
        문의하기 <Icon name="diagonal" />
      </a>
    </div>
  </section>
  <section
    id="services"
    class="services-section section-space"
    aria-labelledby="services-title"
  >
    <div class="container">
      <div class="section-heading">
        <div>
          <p class="eyebrow">OUR CARE SERVICES</p>
          <h2 id="services-title" class="type-section">
            서비스 안내
          </h2>
        </div>
        <p class="section-description">
          가정부터 기업·사무실까지.
          <br />
          전문적인 세 가지 케어.
        </p>
      </div>
      <div class="service-grid">
        {services.map((service) => (
          <a class="service-card" href={service.path}>
            <figure
              class:list={["service-image", `service-image--${service.id}`]}
            >
              <img
                src={service.image}
                width="1000"
                height="667"
                alt={service.imageAlt}
                loading="lazy"
              />
              <span class="service-number eyebrow">{service.number}</span>
            </figure>
            <div class="service-card-body">
              <p class="eyebrow">{service.english}</p>
              <div class="service-card-title">
                <h3 class="type-card">{service.title}</h3>
                <span class="service-arrow">
                  <Icon name="diagonal" />
                </span>
              </div>
              <p class="type-small service-description">
                {service.description}
              </p>
            </div>
          </a>
        ))}
      </div>
      <div class="service-footnote type-small">
        <Icon name="image" />
        <p>위 이미지는 연출을 위한 AI 생성 이미지입니다.</p>
      </div>
    </div>
  </section>
  <Contact />
</SiteLayout>
